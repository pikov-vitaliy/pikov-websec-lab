# Optional local overrides. Leave secrets empty to generate ephemeral values at startup.
SECRET_KEY=
INSTRUCTOR_TOKEN=

# The vulnerable mode is intentional. Use hardened for the repeat test.
LAB_MODE=vulnerable
LAB_PORT=8080

# Direct Python execution binds only to loopback by default.
HOST=127.0.0.1
PORT=8080
DEBUG=false
MAX_UPLOAD_SIZE=2097152
UPLOAD_DIR=data/uploads
LOG_LEVEL=INFO
